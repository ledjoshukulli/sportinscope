# =============================================================================
# SportInScope — Environment Variables
# Copy this file to .env (local dev) and to your hosting provider's env
# settings (Vercel Project Settings → Environment Variables) for
# preview/production. Never commit the real .env file.
# =============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (Supabase, Neon, RDS, local Postgres, etc.)
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/sportinscope?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate. On Supabase this is
# the "Direct connection" string; on providers without pooling, same as above.
DIRECT_URL="postgresql://user:password@host:5432/sportinscope?schema=public"

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_NAME="SportInScope"

# --- Auth (admin/editor login) ----------------------------------------------
# Random 32+ byte secret used to sign admin session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Seed script creates one admin user from these values on first `db:seed` run.
# Change the password after first login.
SEED_ADMIN_EMAIL="admin@sportinscope.com"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ADMIN_NAME="Site Admin"

# --- Sports data providers ---------------------------------------------
# Leave empty during local development — the app automatically falls back to
# the built-in Mock providers (see src/lib/api/providers) so the UI works
# without any external API key.
FOOTBALL_API_KEY=""
FOOTBALL_API_BASE_URL="https://api.football-data.org/v4"
NBA_API_KEY=""
NBA_API_BASE_URL="https://api.balldontlie.io/v1"

# --- Analytics -----------------------------------------------------------
# Google Analytics 4 measurement ID. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=""

# --- Monetization ---------------------------------------------------------
# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Leave empty to
# render ad slots as reserved empty space (no live ads) — useful in dev.
ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADS_ENABLED="false"

# --- Newsletter ------------------------------------------------------------
# API key for your email provider (e.g. Brevo). Leave empty and the
# newsletter form will still store subscribers in the database without
# calling an external provider.
NEWSLETTER_API_KEY=""
NEWSLETTER_PROVIDER="none" # "none" | "brevo"
NEWSLETTER_LIST_ID=""

# --- Optional: future AI content-assistant integration ----------------------
# Not required for the app to function. See src/lib/ai/content-assistant.ts.
AI_API_KEY=""
